# Copy to .streamlit/secrets.toml locally, or set the same keys in
# Streamlit Cloud → App settings → Secrets.
# Never commit real keys.

# Option A: OpenAI (chat + embeddings)
OPENAI_API_KEY = "sk-..."
# OPENAI_BASE_URL = "https://api.openai.com/v1"
# LLM_MODEL = "gpt-4o-mini"
# EMBEDDING_MODEL = "text-embedding-3-small"

# Option B: Groq for chat (embeddings still need OpenAI-compatible key if desired)
# GROQ_API_KEY = "gsk_..."
# GROQ_MODEL = "llama-3.1-8b-instant"
